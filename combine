        f.write('%f  1.2500000  1.025000000  0.00000000000  0.000000000000000\n%f  0.0000000  0.000000000  0.00000000000  0.000000000000000\n')
        f.write('%i    0    0    0    0      0      0      0      0         0\n%i    0    0    0    0      0      0      0      0         0\n')
