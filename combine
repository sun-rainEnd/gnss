        h('     1    AS','# / TYPES OF DATA');h(f'{interval:10.3f}','INTERVAL')
        h('Full-arc processing; reference AC datum, not IGS Time','COMMENT');h('','END OF HEADER')
        for j,t in enumerate(times):
            d=utc_from_sec(t)
            for i,s in enumerate(sats):
                if np.isfinite(K[i,j]):f.write(f'AS {s}  {d.year:4d} {d.month:02d} {d.day:02d} {d.hour:02d} {d.minute:02d} {d.second+d.microsecond/1e6:9.6f}  1   {K[i,j]:19.12E}\n')
    return {'mode':'mansur2024_postprocessed_clock_baseline','sp3':sp3,'clk':clk,
             'records':int(paired.sum()),'clock_records':int(np.isfinite(K).sum()),'grid_epochs':len(times)}


def paper_failure_summary(report):
    """Expose evidence, not just the generic 'supporting orbit failed' label."""
    d=report.get('diagnostics',{});o=d.get('supporting_orbit',{})
    lines=['status: '+str(d.get('status','UNKNOWN'))]
    if o:
        lines.append('supporting_orbit: '+str(o.get('reason','SUCCESS' if o.get('success') else 'UNKNOWN')))
        if o.get('detail'):lines.append(str(o['detail']))
        if o.get('failed_AC'):lines.append('failed AC: '+str(o['failed_AC']))
        if o.get('failed_iteration'):lines.append('failed orbit iteration: '+str(o['failed_iteration']))
        if o.get('last_change_3d_rms_m') is not None:lines.append('last orbit change [m]: '+str(o['last_change_3d_rms_m']))
        for sc,z in o.get('weights',{}).items():
            a=z.get('estimation',{});names=z.get('names',[])
            lines.append(f"orbit {sc}: {a.get('reason','UNKNOWN')}; ACs={','.join(names)}; core={len(z.get('core_satellites',[]))}; scalar samples={a.get('scalar_samples',0)}")
            if a.get('unconstrained_sigma2_m2') is not None:lines.append('  unconstrained sigma2 [m2]: '+str(dict(zip(names,a['unconstrained_sigma2_m2']))))
            if a.get('constraint')=='nonnegative':
                lines.append('  fitted nonnegative sigma2 [m2]: '+str(z.get('sigma2_m2')))
                lines.append('  normalized weights: '+str(z.get('normalized_base_weights')))
                if a.get('boundary_warning'):lines.append('  '+a['boundary_warning'])
            cs=z.get('core_selection',{})
            if cs:lines.append(f"  complete common={cs.get('complete_common_satellites')}; RAC excluded={len(cs.get('excluded_for_RAC_outlier',[]))}; geometry excluded={len(cs.get('excluded_for_RAC_geometry',[]))}")
    for sc,z in d.get('clock_weights',{}).items():
        a=z.get('estimation',{})
        lines.append(f"clock {sc}: {a.get('reason','UNKNOWN')}; core={len(z.get('core_satellites',[]))}; scalar samples={a.get('scalar_samples',0)}")
        if a.get('unconstrained_sigma2_m2') is not None:lines.append('  unconstrained sigma2 [m2]: '+str(dict(zip(z.get('names',[]),a['unconstrained_sigma2_m2']))))
        if a.get('boundary_warning'):lines.append('  '+a['boundary_warning'])
    if d.get('failure_detail'):lines.append(str(d['failure_detail']))
    return '\n'.join(lines)


def paper_diagnose_file(path):
    with open(path,encoding='utf-8-sig') as f:r=json.load(f)
    print(paper_failure_summary(r))
    print('No data or output files changed; negative/underidentified variances are not clipped or replaced.')


def paper_replay_vce_file(path):
    """Replay sufficient second moments only, not original orbit/CLK products."""
    with open(path,encoding='utf-8-sig') as f:r=json.load(f)
    results={}
    for sc,z in r.get('diagnostics',{}).get('supporting_orbit',{}).get('weights',{}).items():
        a=z['estimation'];n=int(a['scalar_samples']);R=len(z['names'])
        if 'misclosure_second_moment_m2' in a:M=np.array(a['misclosure_second_moment_m2'])
        elif R==3 and a.get('unconstrained_sigma2_m2') is not None:
            v=np.array(a['unconstrained_sigma2_m2']);M=np.array([[v[0]+v[1],v[0]],[v[0],v[0]+v[2]]])
        else:raise ValueError('report lacks sufficient moments for replay')
        L=np.linalg.cholesky(M);V=np.zeros((R,n));V[1:,:R-1]=L*np.sqrt(n)
        strict,old=paper_lsvce(V,min_samples=1)
        sig,new=paper_lsvce(V,min_samples=1,constraint='nonnegative')
        results[sc]={'names':z['names'],'strict_reason':old['reason'],'constrained_reason':new['reason'],
             'sigma2_m2':None if sig is None else sig.tolist(),'iterations':new.get('iterations_used'),
             'normalized_weights':None if sig is None else paper_inverse_variance_mean(np.zeros((R,1)),sig)[1][:,0].tolist(),
             'KKT_residual_scaled':new.get('KKT_residual_scaled')}
    print(json.dumps({'scope':'SECOND_MOMENT_REPLAY_ONLY; not original data rerun; no SP3/CLK generated',
                      'results':results},ensure_ascii=False,indent=2))
    return results


def paper_baseline_main(cfg):
    if np is None:raise RuntimeError('NumPy is required')
    if cfg.get('include_b2b',False):raise ValueError('Mansur baseline excludes B2B')
    if cfg.get('strict_no_future_nodes',False):raise ValueError('paper baseline is explicitly offline; strict_no_future_nodes must be false')
    if cfg.get('vce_constraint','unconstrained') not in ('unconstrained','nonnegative'):raise ValueError('invalid vce_constraint')
    interval=float(cfg.get('interval',300))
    if interval!=300.:raise ValueError('paper replication uses 300 s epochs; other intervals need a separate experiment')
    out=cfg['output_dir']
    if os.path.isdir(out) and os.listdir(out):raise ValueError('output_dir is nonempty; use a new directory to preserve results')
    systems=cfg.get('systems',['G','R','E','C']);data=cfg.get('data_dir','.')
    acspec=[p for p in cfg['products'] if p.get('kind','AC').upper()=='AC']
    if len(acspec)<3:raise ValueError('paper LSVCE needs at least three ACs')
    if len({p['name'] for p in acspec})!=len(acspec):raise ValueError('duplicate AC names')
    refs=[p for p in cfg['products'] if p.get('kind','AC').upper()=='REF']
    if len(refs)>1:raise ValueError('use one independent evaluation reference')
    if refs and refs[0]['name'] in {p['name'] for p in acspec}:raise ValueError('REF cannot participate as AC')
    missing=[]
    for p in acspec+refs:
        for key in ('sp3','clk'):
            path=os.path.join(data,p[key])
            if not os.path.isfile(path):missing.append(p['name']+' '+key+': '+path)
    if cfg.get('combined_orbit_file'):
        path=os.path.join(data,cfg['combined_orbit_file'])
        if not os.path.isfile(path):missing.append('combined_orbit_file: '+path)
    if missing:raise ValueError('required input files are missing:\n'+'\n'.join(missing))
    station_map=cfg.get('reference_station_by_ac',{})
    if not isinstance(station_map,dict):raise ValueError('reference_station_by_ac must be an AC-to-station object')
    if set(station_map)-set(p['name'] for p in acspec):
        raise ValueError('reference_station_by_ac may only name participating ACs')
    os.makedirs(out,exist_ok=True)
    def product(p):
        options={**cfg,**p.get('options',{})}
        return Product(p['name'],os.path.join(data,p['sp3']),os.path.join(data,p['clk']),p.get('kind','AC'),systems,options)
    # Read active ACs before REF: independent evaluation cannot change sampling,
    # reference selection, transformations, core satellites, weights or outputs.
    ac=[product(p) for p in acspec];names=[p.name for p in ac]
    if any(not p.orb_times or not p.clk_times for p in ac):raise ValueError('AC has no orbit or clock records')
    start=sec(dt_parse(cfg.get('arc_start',iso_sec(min(min(p.clk_times) for p in ac)))))
    end=sec(dt_parse(cfg.get('arc_end',iso_sec(max(max(p.clk_times) for p in ac)))))
    start=math.ceil(start/interval)*interval;end=math.floor(end/interval)*interval
    if end<start:raise ValueError('empty baseline arc')
    if utc_from_sec(start).date()!=utc_from_sec(end).date():raise ValueError('process one GPST day at a time')
    times=np.arange(start,end+interval*.1,interval)
    sats=sorted(set().union(*(set(p.clk.v)|set(p.orb.v) for p in ac)))
    if cfg.get('satellites'):sats=[s for s in sats if s in cfg['satellites']]
    X=[];K=[];sampling={}
    for p in ac:
        x,k,a=paper_sample(p,sats,times,cfg);X.append(x);K.append(k);sampling[p.name]=a
    X=np.stack(X);raw=np.stack(K)
    settings=['zero MAD treatment and detector sample grouping','median-trend reference selection tie-break',
              'minimum core/support counts','numerical convergence tolerances',
              'orbit RAC RMS aggregation and cumulative within-arc rejection without re-entry',
              'orbit frame gauge fixed to initial participating-AC mean; optional free-gauge sensitivity run',
              'full-arc common satellite coverage with synchronized epoch exclusion',
              'nonpositive variance rejection (article does not specify a numerical remedy)']
    diag={'paper_reproduction':{'clock_paper_doi':'10.1007/s10291-023-01604-4',
              'implementation_revision':'2026-10-13-paper-workflow-review',
