def paper_equation_self_test():
    """Compare reduced equations against independently assembled full model."""
    if np is None:raise RuntimeError('NumPy is required')
    rng=np.random.default_rng(37);R,n=4,24
    basis,_=np.linalg.qr(rng.normal(size=(n,R)));expected=np.array([.01,.04,.09,.16])
    V=(basis*np.sqrt(n*expected)).T
    sig,audit=paper_lsvce(V,min_samples=1)
    np.testing.assert_allclose(sig,expected,rtol=2e-12)
    D=np.vstack([-np.ones((1,R-1)),np.eye(R-1)]);B=np.kron(D,np.eye(n))
    Qt=B.T@np.kron(np.diag(sig),np.eye(n))@B;inv=np.linalg.inv(Qt);t=B.T@V.reshape(-1)
    components=[B.T@np.kron(np.diag(np.eye(R)[i]),np.eye(n))@B for i in range(R)]
    N=np.array([[.5*np.trace(a@inv@b@inv) for b in components] for a in components])
    rhs=np.array([.5*t@inv@a@inv@t for a in components])
    np.testing.assert_allclose(np.linalg.solve(N,rhs),sig,rtol=2e-12)
    order=[2,0,3,1];permuted,_=paper_lsvce(V[order],min_samples=1)
    np.testing.assert_allclose(permuted,sig[order],rtol=2e-12)
    assert paper_lsvce(V[:2],min_samples=1)[0] is None
    z=rng.normal(size=100);assert paper_lsvce(np.stack([z,z,-z]),min_samples=1)[0] is None
    result,weights=paper_inverse_variance_mean(np.array([[[1.,np.nan]],[[3.,5.]],[[9.,11.]]]),np.array([1.,2.,4.]))
    np.testing.assert_allclose(result,[[19./7,7.]]);np.testing.assert_allclose(weights.sum(0),1.)
    constrained,proof=paper_nonnegative_normal(np.array([[2.,1.],[1.,2.]]),np.array([-1.,2.]))
    np.testing.assert_allclose(constrained,[0.,1.])  # refit, not [0, 5/3] clipping
    positive,_=paper_lsvce(V,min_samples=1,constraint='nonnegative')
    np.testing.assert_allclose(positive,expected,rtol=2e-12)
    S=np.array([[.002,-.001],[-.001,.003]])
    boundary_values=np.vstack([np.zeros(2),np.linalg.cholesky(S)*np.sqrt(2)])
    boundary,a=paper_lsvce(boundary_values,min_samples=1,constraint='nonnegative')
    np.testing.assert_allclose(boundary,[0.,.002,.003],rtol=1e-12)
    assert a['reason']=='CONVERGED_BOUNDARY'
    result,w=paper_inverse_variance_mean(np.array([[2.,np.nan],[3.,5.],[9.,11.]]),[0.,2.,4.])
    np.testing.assert_allclose(result,[2.,7.]);np.testing.assert_allclose(w.sum(0),1.)
    print('PASS: Mansur reduced LSVCE matches dense Kronecker equations; reference invariant; no negative-variance clipping; pure inverse variance mean')
    print('PASS: cited nonnegative extension refits components; positive solution preserved; boundary covariance and missing-source weight limits verified')


